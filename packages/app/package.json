{
  "name": "@vaults4626/app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@rainbow-me/rainbowkit": "2.2.7",
    "@tailwindcss/vite": "4.1.10",
    "@tanstack/react-query": "5.80.7",
    "@vaults4626/contracts": "workspace:*",
    "@vaults4626/sdk": "workspace:*",
    "notistack": "3.0.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-modal-hook": "3.0.2",
    "react-router-dom": "7.6.2",
    "tailwind-merge": "3.3.1",
    "tailwindcss": "4.1.10",
    "viem": "2.31.3",
    "wagmi": "2.15.6"
  },
  "devDependencies": {
    "@types/react": "18.3.23",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.5.2",
    "typescript": "5.8.3",
    "vite": "6.3.5",
    "vite-plugin-svgr": "4.3.0",
    "vite-tsconfig-paths": "5.1.4"
  },
  "scripts": {
    "start": "vite",
    "serve": "vite preview",
    "build": "vite build",
    "clean:cache": "rm -rf node_modules/.vite",
    "format": "biome format . --write",
    "format-and-lint": "bun run format && bun run lint:fix:unsafe",
    "lint": "biome check .",
    "lint:all": "bun run lint:fix:unsafe && bun run lint:types",
    "lint:fix": "bun run lint --apply",
    "lint:fix:unsafe": "bun run lint --write --unsafe",
    "lint:types": "tsc -p tsconfig.build.json --noEmit"
  }
}
